+  text-align: center; gap: 2px; pointer-events: none;
+}
+.cf-mid-profit {
+  font-family: var(--mono); font-size: var(--fs-2xl); font-weight: 700; line-height: 1;
+  color: #089981; font-variant-numeric: tabular-nums;
+}
+.cf-mid-profit small { font-size: 12px; font-weight: 400; color: var(--muted); }
+.cf-mid-win { font-family: var(--mono); font-size: var(--fs-lg); font-weight: 700; color: var(--text); margin-top: 6px; }
+.cf-mid-lab { font-family: var(--mono); font-size: 10px; letter-spacing: .1em; text-transform: uppercase; color: var(--muted); }
+/* the optimisation-window statement + best-window CSV on every product page */
+.pdp-window { border: 1px solid #2A2E39; border-left: 3px solid #089981; padding: .75rem 1rem; margin: 0 0 1rem; font-size: .92rem; line-height: 1.5; }
+.pdp-window p { margin: 0; }
+.pdp-window p + p { margin-top: .4rem; }
+.pdp-csv { font-weight: 600; }
