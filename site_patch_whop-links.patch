diff --git a/_tools/gen_pages.py b/_tools/gen_pages.py
index d527e28..87e4a20 100644
--- a/_tools/gen_pages.py
+++ b/_tools/gen_pages.py
@@ -47,7 +47,12 @@ def buy_href(p):
     """The product's Whop page when it has one, else its own page."""
     return p.get("whop") or f"/strategies/{p['slug']}.html"
 HAS_BUNDLES = bool(CAT["strategies"])          # All-Access needs strategies only
-HAS_BOOKS_BUNDLE = bool(CAT["books"])         # The Books needs books
+# owner 2026-09-03: books moved into `strategies` (kind == "book") and CAT["books"] went empty, which
+# silently stopped generating /strategies/the-books.html while the index row, the book pages' crumb and
+# their backlink all still pointed at it — a dead link on the Continuum + Midas row. BOOKS is the list
+# those references need; product pages are still generated once, from `strategies`.
+BOOKS = CAT["books"] or [p for p in CAT["strategies"] if p.get("kind") == "book"]
+HAS_BOOKS_BUNDLE = bool(BOOKS)                # The Books needs books
 HAS_STARTER = bool(CAT["bundles"].get("starter", {}).get("slugs")) and all(
     s in {x["slug"] for x in CAT["strategies"]}
     for s in CAT["bundles"].get("starter", {}).get("slugs", []))
@@ -1222,7 +1227,7 @@ def market_chips(meta):
 
 # ── strategy + book pages ───────────────────────────────────────
 THEMED = {p["slug"] for p in CAT["strategies"]}
-THEMED |= {b["slug"] for b in CAT["books"]}
+THEMED |= {b["slug"] for b in BOOKS}
 
 os.makedirs(os.path.join(BASE, "strategies"), exist_ok=True)
 urls = ["/", "/plan.html", "/terms.html", "/privacy.html"]
@@ -1313,8 +1318,8 @@ def product_page(p, is_book):
     xsell = None
     struck = None
     if is_book:
-        others = [bk for bk in CAT["books"] if bk["slug"] != p["slug"]]
-        xsell = ('All four engines: <a href="/strategies/the-books.html">The Books — ${BN["books_all"]["price"]}/mo</a> · '
+        others = [bk for bk in BOOKS if bk["slug"] != p["slug"]]
+        xsell = ('Both engines: <a href="/strategies/the-books.html">The Books — ${BN["books_all"]["price"]}/mo</a> · '
                  + " · ".join(f'<a href="/strategies/{o["slug"]}.html">{esc(o["name"])}</a>' for o in others[:2]))
     page = head(f"{p['name']} — FuturesTradingBots", mdesc, path,
                 bodycls=(f"pdp-theme fc-{p['slug']}" if p["slug"] in THEMED else ""))
@@ -1376,7 +1381,7 @@ def product_page(p, is_book):
 if not PRELAUNCH:
     for p in CAT["strategies"]:
         product_page(p, is_book=False)
-    for p in CAT["books"]:
+    for p in CAT["books"]:                     # empty once books live in `strategies`; kept for older catalogs
         product_page(p, is_book=True)
 
 # ── bundle pages ────────────────────────────────────────────────
@@ -1438,16 +1443,16 @@ if not PRELAUNCH and HAS_BOOKS_BUNDLE:
     book_rows = "".join(
         f'<li><a class="sys-link" href="/strategies/{b["slug"]}.html"><span class="inc-name">{esc(b["name"])}</span></a>'
         f'<span class="inc-price">{esc(b["actual"])} · ${b["price"]:,}/mo solo</span></li>'
-        for b in CAT["books"])
+        for b in BOOKS)
     _pp = BN["all_access"].get("prepay")
     bundle_page("the-books", "The Books", BN["books_all"]["price"], BN["books_all"]["combined"],
-        "All four in-house engines. The metric that matters at this level: return on drawdown.",
+        "Both whole-day engines in one subscription. The metric that matters at this level: return on drawdown.",
         f"""<div class="record">
-            <div class="record-title">Included — all four in-house engines</div>
+            <div class="record-title">Included — both whole-day engines</div>
             <ul class="included">{book_rows}</ul>
-            <p class="record-note">The engines we run ourselves. Each book is also sold separately; this tier is all four, priced under any two solo.</p>
+            <p class="record-note">The engines we run ourselves. Each book is also sold separately; this tier is both, priced under the pair.</p>
           </div>""",
-        'Not ready for the engines? <a href="/strategies/all-access.html">All-Access — $999/mo</a>')
+        f'Not ready for the engines? <a href="/strategies/all-access.html">All-Access — ${BN["all_access"]["price"]:,}/mo</a>')
 
 if not PRELAUNCH and HAS_STARTER:
     ST = BN["starter"]
