+  .tvr .tvr-ovdonut { border-left: none; padding-left: 0; border-top: 1px solid #2a2e39; padding-top: 12px; }
+  .tvr .tvr-legend { gap: 3px; }
+}
+
+/* ================================================================
+   r8.3 — owner round 3 (2026-09-03).
+   Index: The Books (combined row + the two books) on top, then the
+   Combo sets, then the singles per market; Best / Worst month and
+   the two drawdown columns; Session (ET) from the catalog.
+   Product page: the report band is a direct child of the wrap
+   between the head and the body article; compact buy box; the
+   report's title block (glyph + name in the identity colour);
+   "4 ticks per bar" / "On bar close" chips; no caret; Overview
+   without gross rows; Streaks visual.
+   ================================================================ */
+.pdp-top { padding-bottom: 0; }
+.pdp-body { padding-top: 0; }
+.pdp-band { margin: var(--sp-4) 0 var(--sp-5); }
+
+.tvr-title { display: inline-flex; align-items: center; gap: 10px; margin-right: 6px; max-width: 46%; min-width: 0; }
+.tvr-glyph { width: 30px; height: 30px; flex: 0 0 30px; stroke: var(--fc, #D1D4DC); color: var(--fc, #D1D4DC); }
+.tvr-tt { display: flex; flex-direction: column; min-width: 0; line-height: 1.15; }
+.tvr-tt b { font-family: var(--display); font-size: 24px; font-weight: 700; color: var(--fc, #D1D4DC); white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
+.tvr-tt small { font-size: 12px; color: #787B86; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin-top: 2px; }
+.tvr-top { padding: 8px 12px; gap: 8px; }
+@container (max-width: 560px) { .tvr .tvr-tt b { font-size: 19px; } .tvr .tvr-title { max-width: 100%; } .tvr .tvr-top > span:nth-of-type(4), .tvr .tvr-top > span:nth-of-type(5) { display: none; } }
+
+.bb { padding: var(--sp-3) var(--sp-4); }
+.bb-now { font-size: 1.9rem; }
+.bb-hook { margin-bottom: .5rem; }
+.bb-list { margin-bottom: .6rem; }
+.bb-list li { font-size: .8rem; padding: 4px 0; }
+.bb-btn { width: auto; display: inline-flex; min-height: 42px; padding: 0 22px; font-size: .95rem; margin: .3rem 0 .4rem; }
+.bb-safe { text-align: left; }
+.bb-promo { text-align: left; }
+.pdp-side .buybox { position: sticky; top: calc(var(--header-h) + var(--sp-4)); }
+
+.tvr-streaks { width: 100%; height: auto; display: block; margin: 0 0 6px; }
+.tvr-slab { font-family: var(--sans); font-size: 10px; }
+.tvr-slab-w { fill: #26a69a; }
+.tvr-slab-l { fill: #ef5350; }
+.tvr-ovbot .tvr-cells-2 .tvr-cell:nth-child(5) { border-left: none; padding-left: 0; }
+
+.sx-lede-sec { margin: -0.2rem 0 0.6rem; font-size: 0.85rem; color: #9aa2a8; max-width: 90ch; }
+.sx-t td .sx-mo { display: block; font-family: "Fragment Mono", "Courier New", monospace; font-size: 0.66rem; font-weight: 400; letter-spacing: .06em; text-transform: uppercase; color: #787B86; margin-top: .1rem; }
+.sx-t td.sx-pos { color: #089981; }
+.sx-t td.sx-neg { color: #F23645; }
+.sx-t th.sx-rodd, .sx-t th.sx-f:not(.sx-rodd):not(.sx-p), .sx-t th.sx-s, .sx-t th.sx-p { width: auto; }
+.sx-t th.sx-n { width: 24%; }
+/* the wider column set sizes to content and scrolls inside .sx-scroll; fixed layout squeezed the headers */
+.sx-t { table-layout: auto; min-width: 100%; }
+.sx-t th, .sx-t td.sx-f, .sx-t td.sx-s, .sx-t td.sx-r { white-space: nowrap; }
+.sx-t td.sx-n { min-width: 15rem; }
+.sx-t th.sx-n { width: auto; }
+.sx-t td.sx-s { text-align: left; }
+.sx-combined { display: inline-flex; align-items: center; gap: .35rem; font-weight: 700; color: var(--fc, #F5D07A); }
+.sx-combined .sx-g { color: var(--fc, #F5D07A); }
+/* the two wider tables tighten so all twelve columns fit the wrap at 1400 */
+.sx-t-wide th, .sx-t-wide td { padding: 0.5rem 0.4rem; }
+.sx-t-wide td.sx-f, .sx-t-wide td.sx-r, .sx-t-wide td.sx-f a { font-size: 0.78rem; }
+.sx-t-wide th { font-size: 0.66rem; letter-spacing: 0; }
+.sx-t-wide td.sx-n { min-width: 12rem; }
+.sx-t-wide .sx-sub, .sx-t-wide .sx-book { font-size: 0.72rem; }
+.sx-t-wide td.sx-net { font-size: 0.92rem; }
+.buybox .bb-btn { width: auto; min-height: 42px; margin-bottom: .4rem; }
